{
  "ReverseProxy": {
    "Routes": {
      "legacy-fallback": {
        "ClusterId": "legacy-cluster",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Off"
          },
          {
            "RequestHeader": "X-Migration-Phase",
            "Set": "Phase1-FullLegacy"
          }
        ]
      }
    },

    "Clusters": {
      "legacy-cluster": {
        "Destinations": {
          "legacy": {
            "Address": "http://localhost:5001/"
          }
        }
      }
    }
  }
}