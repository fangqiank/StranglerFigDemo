{
  "ReverseProxy": {
    "Routes": {
      "modern-get-users": {
        "ClusterId": "modern-cluster",
        "Match": {
          "Path": "/api/users",
          "Methods": [ "GET" ]
        }
      },
      "modern-get-user-by-id": {
        "ClusterId": "modern-cluster",
        "Match": {
          "Path": "/api/users/{id}",
          "Methods": [ "GET" ]
        }
      },
      "modern-create-user": {
        "ClusterId": "modern-cluster",
        "Match": {
          "Path": "/api/users",
          "Methods": [ "POST" ]
        }
      },
      "modern-update-user": {
        "ClusterId": "modern-cluster",
        "Match": {
          "Path": "/api/users/{id}",
          "Methods": [ "PUT" ]
        }
      },
      "modern-delete-user": {
        "ClusterId": "modern-cluster",
        "Match": {
          "Path": "/api/users/{id}",
          "Methods": [ "DELETE" ]
        }
      },
      "legacy-fallback": {
        "ClusterId": "legacy-cluster",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Order": 100
      }
    },
    "Clusters": {
      "legacy-cluster": {
        "Destinations": {
          "legacy": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "modern-cluster": {
        "Destinations": {
          "modern": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}