{
  "name": "legacy-api-node",
  "version": "2.3.1",
  "description": "LegacyApi rewritten in Node.js Express (Strangler Fig Pattern demo)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:setup": "npx prisma generate && npx prisma db push && node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^11.9.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@prisma/config": "^7.8.0",
    "prisma": "^7.8.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
